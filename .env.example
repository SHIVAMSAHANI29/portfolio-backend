# ==========================================================
# SERVER
# ==========================================================
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:5500

# ==========================================================
# DATABASE
# ==========================================================
MONGODB_URI=your_mongodb_connection_string

# ==========================================================
# AUTH
# ==========================================================
JWT_SECRET=your_secure_random_jwt_secret
JWT_EXPIRES_IN=7d

# Used only once, by scripts/createAdmin.js, to create the first admin account
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change_this_before_running_create-admin

# ==========================================================
# EMAIL (SMTP via Nodemailer)
# ==========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
CONTACT_EMAIL=where_you_want_to_receive_messages@example.com
